{
  "name": "website-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/ai-marketing/legacy-content-audit.mjs --strict",
    "build": "tsc -b && vite build",
    "postbuild": "node postbuild.mjs",
    "check:links": "node tools/check-links.mjs",
    "video:sync": "node tools/sync-video-pages.mjs",
    "video:check": "node tools/sync-video-pages.mjs --check",
    "sitemap:sync": "node tools/sync-sitemap.mjs",
    "sitemap:check": "node tools/sync-sitemap.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "gsc": "node tools/ai-marketing/gsc-fetch-private.mjs",
    "gsc:private": "node tools/ai-marketing/gsc-fetch-private.mjs --require-rows",
    "gsc:bootstrap": "node tools/ai-marketing/gsc-url-prefix-bootstrap.mjs prepare",
    "seo:plan": "node tools/ai-marketing/seo-growth-engine.mjs",
    "seo:plan:strict": "node tools/ai-marketing/seo-growth-engine.mjs --require-gsc",
    "seo:expert": "node tools/ai-marketing/seo-expert-plan.mjs",
    "seo:publish": "node tools/ai-marketing/seo-production-runner.mjs",
    "seo:publish:dry": "node tools/ai-marketing/seo-production-runner.mjs --dry-run",
    "seo:cold-start": "node tools/ai-marketing/cold-start-growth.mjs",
    "seo:cold-start:dry": "node tools/ai-marketing/cold-start-growth.mjs --dry-run",
    "seo:smoke:gemini": "node tools/ai-marketing/gemini-smoke.mjs",
    "seo:audit:legacy": "node tools/ai-marketing/legacy-content-audit.mjs --strict",
    "test:cold-start": "node --test tools/ai-marketing/cold-start-growth.test.mjs",
    "test:seo-growth": "node --test tools/ai-marketing/cold-start-growth.test.mjs tools/ai-marketing/gsc-evidence-gate.test.mjs tools/ai-marketing/gsc-safe-snapshot.test.mjs tools/ai-marketing/gsc-index-priority.test.mjs tools/ai-marketing/model-json.test.mjs tools/ai-marketing/gsc-fetch-private.test.mjs tools/ai-marketing/rebuild-blog-index.test.mjs tools/ai-marketing/seo-growth-engine.test.mjs tools/ai-marketing/seo-publisher-core.test.mjs tools/ai-marketing/seo-structured-data.test.mjs tools/ai-marketing/seo-expert-plan.test.mjs tools/ai-marketing/gemini-grounded-research.test.mjs tools/ai-marketing/seo-production-runner.test.mjs",
    "worker:dev": "tsx apps/worker/src/serve.ts",
    "audit:site": "tsx apps/worker/src/cli.ts audit:site",
    "keywords:generate": "tsx apps/worker/src/cli.ts keywords:generate",
    "blog:create": "tsx apps/worker/src/cli.ts blog:create",
    "social:repurpose": "tsx apps/worker/src/cli.ts social:repurpose",
    "report:weekly": "tsx apps/worker/src/cli.ts report:weekly",
    "test:marketing": "tsx --test \"packages/**/*.test.ts\"",
    "gsc:evidence": "node tools/ai-marketing/gsc-evidence-gate.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "cheerio": "^1.2.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "express": "^5.2.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3"
  }
}
