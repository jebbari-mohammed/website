{
  "name": "website-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node postbuild.mjs",
    "check:links": "node tools/check-links.mjs",
    "video:sync": "node tools/sync-video-pages.mjs",
    "video:check": "node tools/sync-video-pages.mjs --check",
    "sitemap:sync": "node tools/sync-sitemap.mjs",
    "sitemap:check": "node tools/sync-sitemap.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "gsc": "node tools/ai-marketing/search-console.mjs",
    "seo:plan": "node tools/ai-marketing/seo-growth-engine.mjs",
    "seo:plan:strict": "node tools/ai-marketing/seo-growth-engine.mjs --require-gsc",
    "test:seo-growth": "node --test tools/ai-marketing/seo-growth-engine.test.mjs",
    "worker:dev": "tsx apps/worker/src/serve.ts",
    "audit:site": "tsx apps/worker/src/cli.ts audit:site",
    "keywords:generate": "tsx apps/worker/src/cli.ts keywords:generate",
    "blog:create": "tsx apps/worker/src/cli.ts blog:create",
    "social:repurpose": "tsx apps/worker/src/cli.ts social:repurpose",
    "report:weekly": "tsx apps/worker/src/cli.ts report:weekly",
    "test:marketing": "tsx --test \"packages/**/*.test.ts\""
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^5.2.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "puppeteer": "^24.43.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
