# LLM providers. Configure any one, none required for deterministic local drafts.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
ANTHROPIC_API_KEY=
MARKETING_LLM_PROVIDER=

# SEO production model order. Gemini 3.6 Flash is the primary production model;
# the publisher automatically falls back across models and configured API keys.
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.6-flash
SEO_GEMINI_MODEL=gemini-3.6-flash
SEO_GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Search Console. Use a service account with read-only Search Console
# access to sc-domain:youraicoach.life. Never commit the real JSON credential;
# store it in the GOOGLE_SERVICE_ACCOUNT_JSON GitHub Actions repository secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:youraicoach.life
GSC_DAYS=28
GSC_DIMENSIONS=query,page
GSC_ROW_LIMIT=2500

# Optional Postiz draft integration.
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com

# Worker server.
MARKETING_WORKER_PORT=4317
