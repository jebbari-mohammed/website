# LLM providers. Configure any one, none required for deterministic local drafts.
# You can provide multiple comma-separated keys (e.g. key1,key2) to support automatic failover/switching if a key fails.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MARKETING_LLM_PROVIDER=

# Optional model overrides.
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Search Console. Prefer a service account with read-only Search Console access.
# Never commit the real JSON credential. In GitHub Actions, store it as the
# GOOGLE_SERVICE_ACCOUNT_JSON repository secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:youraicoach.life
GSC_DAYS=28
GSC_DIMENSIONS=query,page
GSC_ROW_LIMIT=2500

# Optional Postiz draft integration.
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com

# Worker server.
MARKETING_WORKER_PORT=4317
